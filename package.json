{
  "name": "sto-suprunec",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check": "tsc -b",
    "build:github": "cross-env DEPLOY_TARGET=github tsc -b && cross-env DEPLOY_TARGET=github vite build",
    "build:vercel": "cross-env DEPLOY_TARGET=vercel tsc -b && cross-env DEPLOY_TARGET=vercel vite build",
    "prepare:nova-poshta": "node scripts/prepare-nova-poshta-dashboard.cjs",
    "watch:nova-poshta-env": "node scripts/watch-nova-poshta-env.cjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy": "npm run build:github && gh-pages -d dist --no-history",
    "deploy1": "git status -sb && git add -A && (git diff --cached --quiet || git commit -m \"Update STO Suprunec\") && git push origin main && npm run deploy",
    "deploy2": "npm run deploy1",
    "vercel": "npm run build:vercel && vercel --prod --yes",
    "vercel:test": "npm run build:vercel && vercel --yes",
    "vercel:prod": "npm run build:vercel && vercel --prod --yes"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.4",
    "apexcharts": "^5.6.0",
    "daterangepicker": "^3.1.0",
    "dompurify": "^3.3.3",
    "jquery": "^3.7.1",
    "jspdf": "^3.0.1",
    "moment": "^2.30.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.2.0",
    "@capacitor/cli": "^8.2.0",
    "@capacitor/core": "^8.2.0",
    "@capacitor/ios": "^8.2.0",
    "@eslint/js": "^9.25.0",
    "@types/dompurify": "^3.0.5",
    "@types/jquery": "^3.5.32",
    "@types/jspdf": "^1.3.3",
    "@types/node": "^25.6.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "cross-env": "^7.0.3",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "gh-pages": "^6.3.0",
    "globals": "^16.0.0",
    "sass": "^1.89.0",
    "sass-embedded": "^1.89.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5"
  }
}
